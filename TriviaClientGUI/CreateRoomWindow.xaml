<Window x:Class="TriviaClientGUI.CreateRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Room" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        
        <Grid.Background>
            <ImageBrush ImageSource="Images/create_room_background.png" Stretch="Fill"/>
        </Grid.Background>

        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="58,0,0,0" Width="250">
            <TextBlock Text="Room Name:" Foreground="Red"/>
            <TextBox x:Name="RoomNameBox" Margin="0,5"/>

            <TextBlock Text="Max Users:" Foreground="Red"/>
            <TextBox x:Name="MaxUsersBox" Margin="0,5"/>

            <TextBlock Text="Number of Questions:" Foreground="Red"/>
            <TextBox x:Name="QuestionsBox" Margin="0,5"/>

            <TextBlock Text="Answer Timeout (sec):" Foreground="Red"/>
            <TextBox x:Name="TimeoutBox" Margin="0,5"/>

            <Button Content="Create Room" Margin="0,20" Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
