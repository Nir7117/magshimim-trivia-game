<Window x:Class="TriviaClientGUI.GameResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Results" Height="400" Width="600" Background="AliceBlue">
    <Grid Margin="20">
        <TextBlock Text="Game Results" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,0" />

        <ListView Name="ResultsListView" Margin="0,60,0,60" FontSize="16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Player" DisplayMemberBinding="{Binding Username}" Width="200"/>
                    <GridViewColumn Header="Correct Answers" DisplayMemberBinding="{Binding CorrectCount}" Width="150"/>
                    <GridViewColumn Header="Avg Time" DisplayMemberBinding="{Binding AvgTime}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Content="Back to Menu" Click="Back_Click" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
