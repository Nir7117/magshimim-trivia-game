<Window x:Class="TriviaClientGUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/kakashi_login_background.png" Stretch="Fill"/>
        </Grid.Background>

       
        <Grid Margin="40" Background="#AAFFFFFF" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Username" Foreground="Black" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Grid.Row="1" Height="30" Background="White" Padding="5"/>

            <TextBlock Text="Password" Grid.Row="2" Margin="0,15,0,5" Foreground="Black" FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="30" Background="White" Padding="5"/>

            <Button Grid.Row="4" Content="Login"
                    Background="#4A90E2" Foreground="White" Height="35"
                    Margin="0,20,0,0" Click="LoginButton_Click"
                    FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>

            <Button Grid.Row="4" Content="Back To Menu"
                    Background="brown" Foreground="White" Height="35"
                    Margin="333,20,-333,0" Click="BackButton_Click"
                    FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
