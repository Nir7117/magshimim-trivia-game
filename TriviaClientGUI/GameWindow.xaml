<Window x:Class="TriviaClientGUI.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameWindow"
        Height="450" Width="800"
        Background="#2D2D30"
        Foreground="White">
    <Grid Margin="20">
        <TextBlock x:Name="QuestionText"
                   FontSize="20"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <UniformGrid Rows="2" Columns="2" Margin="0,80,0,0">
            <Button x:Name="Answer1"
                    Click="Answer_Click"
                    FontSize="16"
                    Margin="10"
                    Background="Pink"
                    Foreground="White"/>
            <Button x:Name="Answer2"
                    Click="Answer_Click"
                    FontSize="16"
                    Margin="10"
                    Background="LightGreen"
                    Foreground="White"/>
            <Button x:Name="Answer3"
                    Click="Answer_Click"
                    FontSize="16"
                    Margin="10"
                    Background="LightBlue"
                    Foreground="White"/>
            <Button x:Name="Answer4"
                    Click="Answer_Click"
                    FontSize="16"
                    Margin="10"
                    Background="MediumPurple"
                    Foreground="White"/>
        </UniformGrid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10">
            <TextBlock x:Name="CounterText"    FontSize="14" Margin="10"/>
            <TextBlock x:Name="CorrectText"    FontSize="14" Margin="10"/>
            <TextBlock x:Name="TimerText"      FontSize="14" Margin="10"/>
            <TextBlock x:Name="CorrectSoFarText" FontSize="14" Margin="10"/>
            <TextBlock x:Name="RemainingText"  FontSize="14" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
