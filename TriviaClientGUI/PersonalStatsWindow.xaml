<Window x:Class="TriviaClientGUI.PersonalStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersonalStatsWindow" Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/Personal_Stats.png" Stretch="Fill"/>
        </Grid.Background>

        <Canvas>
            <TextBlock x:Name="CorrectAnswersText" FontSize="16" Foreground="Beige"
                       Canvas.Left="24" Canvas.Top="173" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalAnswersText" FontSize="16" Foreground="Beige"
                       Canvas.Left="20" Canvas.Top="220" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBlock x:Name="AvgTimeText" FontSize="16" Foreground="Beige"
                       Canvas.Left="22" Canvas.Top="262" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBlock x:Name="GamesPlayedText" FontSize="16" Foreground="Beige"
                       Canvas.Left="22" Canvas.Top="310" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <Button Content="Back" Click="Back_Click" Width="144"
                    Canvas.Left="30" Canvas.Top="383" HorizontalAlignment="Left" Height="41" VerticalAlignment="Center"/>
        </Canvas>
    </Grid>
</Window>
