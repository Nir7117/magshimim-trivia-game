<Window x:Class="TriviaClientGUI.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signup" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- IMG background -->
        <Grid.Background>
            <ImageBrush ImageSource="Images/sasuke_signup_background.png" Stretch="Fill"/>
        </Grid.Background>

        <!-- Sugnup -->
        <Grid Background="#AAFFFFFF" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="20.96"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Username" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Grid.Row="1" Background="White" Padding="5" Margin="0,10,0,10"/>

            <TextBlock Text="Password" Grid.Row="2" Margin="0,10,0,5" FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Background="White" Padding="5" Margin="0,10,0,10"/>

            <TextBlock Text="Email" Grid.Row="4" Margin="0,10,0,5" FontWeight="Bold"/>
            <TextBox x:Name="EmailBox" Grid.Row="5" Background="White" Padding="5" Margin="0,10,0,10"/>

            <Button Grid.Row="6" Content="Signup"
                    Background="#6A1B9A" Foreground="White"
                    Margin="0,20,0,0" Click="SignupButton_Click"
                    FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
