<Window x:Class="TriviaClientGUI.RoomLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Lobby" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
       
        <Grid.Background>
            <ImageBrush ImageSource="Images/lobby_background.png" Stretch="Fill"/>
        </Grid.Background>
        <Button Content="Refresh"
        Click="RefreshButton_Click"
        Background="Green"
        Foreground="White"
        Padding="8,4"
        FontWeight="Bold"
        Width="129"
        Margin="0,10,10,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top" Height="32"/>


        <StackPanel Margin="10,20,20,20">
            <TextBlock x:Name="RoomNameLabel"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10" Height="39" Width="642"/>

            <TextBlock x:Name="AdminLabel"
                       FontSize="18"
                       FontStyle="Italic"
                       Foreground="Blue"
                       Margin="0,0,0,10"/>

            <Separator Background="White" Height="2" Margin="0,0,0,10"/>

            <TextBlock Text="PLAYERS:"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="PlayersList"
                     Background="#AA222222"
                     BorderBrush="Gray"
                     Foreground="LightGreen"
                     FontSize="16"
                     Height="200"
                     Margin="0,0,0,10"/>
            <Button x:Name="StartGameButton"
            Content="Start Game"
            Click="StartGame_Click"
            Background="Blue"
            Foreground="White"
            Padding="8,4"
            FontWeight="Bold"
            Width="150"
            Margin="0,0,10,0"
            Visibility="Collapsed" />

            <Button x:Name="LeaveRoomButton"
        Content="Leave Room"
        Width="100"
        Height="30"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,20,20"
        Click="LeaveRoom_Click"/>

            <Button x:Name="CloseRoomButton"
            Content="Close Room"
            Click="CloseRoom_Click"
            Background="Red"
            Foreground="White"
            Padding="8,4"
            FontWeight="Bold"
            Width="150"
            Visibility="Collapsed" />

            <Button Content="Back to Menu"
                    Click="BackToMenu_Click"
                    HorizontalAlignment="Left"
                    Background="#FF444444"
                    Foreground="White"
                    Padding="8,4"
                    FontWeight="Bold"
                    Width="150"/>
        </StackPanel>


    </Grid>
</Window>
