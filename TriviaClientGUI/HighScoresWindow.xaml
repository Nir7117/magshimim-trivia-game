<Window x:Class="TriviaClientGUI.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HighScoresWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        
        <Grid.Background>
            <ImageBrush ImageSource="Images/HighScores.png" Stretch="Fill"/>
        </Grid.Background>

        <TextBlock Text="High Scores"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="Beige"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>

        <ListView x:Name="HighScoresList"
                  Margin="34,105,166,55"
                  Background="Transparent"
                  BorderThickness="1"
                  BorderBrush="Beige"
                  FontSize="16"
                  Foreground="Beige">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" DisplayMemberBinding="{Binding Username}" Width="300"/>
                    <GridViewColumn Header="Score" DisplayMemberBinding="{Binding Score}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Content="Back"
                Click="Back_Click"
                Width="100"
                Height="35"
                FontWeight="SemiBold"
                Background="#444"
                Foreground="Beige"
                BorderBrush="Gray"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,20"/>
    </Grid>
</Window>
