<Window x:Class="TriviaClientGUI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFFAFAFA">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Height="150" >
            <TextBlock Text="Welcome to Trivia!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <Button Content="Login" Click="Login_Click" Height="35" Margin="0,10,0,10" Background="#FF2196F3" Foreground="White" />
            <Button Content="Signup" Click="Signup_Click" Height="35" Background="#FF4CAF50" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
