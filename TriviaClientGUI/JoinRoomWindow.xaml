<Window x:Class="TriviaClientGUI.JoinRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Room" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="77*"/>
            <ColumnDefinition Width="23*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.Background>
            <ImageBrush ImageSource="Images/joinroom_background.png" Stretch="Fill"/>
        </Grid.Background>

       
        <Border Margin="27,0,62,80" Background="#AA000000" Padding="20" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Available Rooms"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,15"/>

                <ListBox x:Name="RoomsList"
                         Background="#EEEEEE"
                         BorderThickness="0"
                         FontSize="16"
                         Height="200"
                         Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Join Selected Room"
                            Click="JoinButton_Click"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            Background="green"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button Content="Back"
                            Click="BackButton_Click"
                            Padding="10,5"
                            Background="red"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
